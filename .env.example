# Free-form journeys require an inference provider configured for Hermes.
# Never put real credentials in prompts or version control.
PROOFRUNNER_MODEL=
PROOFRUNNER_BASE_URL=
PROOFRUNNER_API_KEY=
# Only names explicitly referenced by fill-secret are read.
PR_TEST_USER=
PR_TEST_PASSWORD=
# Official Agent Index registration/reporting, supplied by Plow.
PLOW_AGENT_TOKEN=
AGENT_ID=proofrunner
